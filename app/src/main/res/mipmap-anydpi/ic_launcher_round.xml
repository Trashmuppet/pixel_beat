<?xml version="1.0" encoding="utf-8"?>
<!--
    Fallback round launcher vector for API 24-25. Identical
    composition to the square fallback; Android's pre-O launchers
    mask it to a circle independently of what the resource declares.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="@color/mono_black"
        android:pathData="M0,0 L108,0 L108,108 L0,108 Z" />
    <path
        android:fillColor="@color/mono_white"
        android:pathData="M54,24 A30,30 0 1,1 53.999,24 Z" />
</vector>
