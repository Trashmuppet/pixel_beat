# Example release signing config for Monochrome Beat.
#
# COPY this file to `app/keystore.properties` and replace the empty
# fields with your real `release.keystore` secrets before running
# `./gradlew :app:assembleRelease`.
#
# The real `keystore.properties` is gitignored. NEVER commit it.
#
# Generate `release.keystore` with:
#   keytool -genkey -v -keystore release.keystore \
#           -keyalg RSA -keysize 2048 -validity 9125 \
#           -alias upload
#
# Then update `storeFile`, `storePassword`, `keyAlias`, `keyPassword`
# from this template.
storeFile=release.keystore
storePassword=
keyAlias=upload
keyPassword=
